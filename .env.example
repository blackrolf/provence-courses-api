# ===========================================
# Provence Courses API - Configuration
# ===========================================
# Copier ce fichier en .env et remplir les valeurs

# Application
APP_NAME=Provence Courses API
APP_VERSION=1.0.0
ENVIRONMENT=development  # development | production

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# ===========================================
# Supabase (REQUIS)
# ===========================================
# Récupérer depuis : https://supabase.com/dashboard/project/[project-id]/settings/api
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===========================================
# OSRM - Routing Engine
# ===========================================
# URL du serveur OSRM pour le calcul des distances
# Si local : http://localhost:5000
# Si distant : http://votre-serveur-osrm:5000
OSRM_URL=http://localhost:5000

# ===========================================
# Google Maps API (OPTIONNEL)
# ===========================================
# Utilisé en fallback si OSRM n'est pas disponible
# Récupérer depuis : https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=
GOOGLE_MAPS_API_KEY=

# ===========================================
# Sécurité API
# ===========================================
# Clé pour authentifier les appels API
# Générer avec : openssl rand -hex 32
API_KEY=votre-cle-api-secrete
